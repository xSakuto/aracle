# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Öffentliche Adresse der Seite (für Login-Links)
NEXT_PUBLIC_SITE_URL=https://aracle.ch

# Kontaktformular: Benachrichtigung per Mail (optional, https://resend.com)
RESEND_API_KEY=re_...
# Absender muss in Resend verifiziert sein, z.B. anfragen@arcl.ch
INQUIRY_FROM=Aracle <anfragen@arcl.ch>
INQUIRY_TO=info@arcl.ch
